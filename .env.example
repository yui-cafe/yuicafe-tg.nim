# Create a bot with @BotFather and store its token in a secret manager.
TELEGRAM_BOT_TOKEN=123456789:replace-with-a-real-token

# Bot API endpoint. Use the default unless connecting to a local Bot API server.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Long-polling settings.
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_POLL_LIMIT=100
TELEGRAM_ALLOWED_UPDATES=message

# HTTP request timeout and retry settings for retry-safe Bot API calls.
TELEGRAM_REQUEST_TIMEOUT_MS=40000
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY_MS=500
TELEGRAM_RETRY_MAX_DELAY_MS=30000

# Backoff settings for failures in the long-polling loop.
TELEGRAM_FAILURE_DELAY_MS=1000
TELEGRAM_FAILURE_MAX_DELAY_MS=30000

# SQLite database used to persist warnings across restarts.
TELEGRAM_DATABASE_PATH=yuicafe.sqlite3

# Comma-separated Telegram user IDs that may use owner-only commands, such as
# /status. Group administrators authorize /warn and /ban in their own chats.
TELEGRAM_OWNER_IDS=

# Set only when intentionally migrating from webhooks to long polling.
TELEGRAM_DELETE_WEBHOOK=false
